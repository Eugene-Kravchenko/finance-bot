# Перевыпустите токен через BotFather. Не используйте токен, опубликованный в переписке.
BOT_TOKEN=PASTE_NEW_TOKEN_HERE
TZ=Europe/Moscow
CHECKIN_TIMES=10:00,16:00,22:00
DB_PATH=data/mood.sqlite3

# Необязательно: Telegram chat ID человека, который сможет получать /report и /export.
# Узнать свой ID можно командой /id. Участница видит это условие до согласия.
ADMIN_CHAT_ID=0
